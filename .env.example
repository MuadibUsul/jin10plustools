# 复制为 .env 后填写。.env 不要提交到代码仓库。

# 数据库
POSTGRES_USER=plus
POSTGRES_PASSWORD=请改为随机强密码
POSTGRES_DB=plus

# 登录令牌签名密钥（随机长字符串，可用：python -c "import secrets;print(secrets.token_urlsafe(48))"）
PLUS_JWT_SECRET=请改为随机长字符串
# 可选：独立的团队 AI 密钥加密主密钥（留空则使用存储卷内自动生成并持久化的密钥）
PLUS_TEAM_KEY_SECRET=

# 服务端口
PLUS_API_PORT=8000

# AI 模型接入配置（可在网页「设置」中按团队覆盖）
PLUS_JEV_API_KEY=
PLUS_BRIEFS_DEEPSEEK_API_KEY=
PLUS_BRIEFS_DEEPSEEK_MODEL=
PLUS_CHAT2API_URL=http://chat2api:5005
PLUS_CHAT2API_PREFIX=
PLUS_CHAT2API_KEY=
PLUS_CHAT2API_MODEL=gpt-4o-mini
PLUS_OPENAI_API_KEY=
PLUS_OPENAI_MODEL=gpt-4o-mini

# 固定快讯编辑风格模式
PLUS_BRIEFS_GPU_EDITORIAL_MODE=shadow
PLUS_BRIEFS_EDITORIAL_MODE=shadow

# News Skill OS 工作台（Plus新鲜事 / Plus注解辅助；生产环境设为 true，本地默认 false）
NEWS_SKILL_OS_ENABLED=false
