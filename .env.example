# 复制为 .env 后填写。.env 不要提交到代码仓库。

# 数据库
POSTGRES_USER=plus
POSTGRES_PASSWORD=请改为随机强密码
POSTGRES_DB=plus

# 登录令牌签名密钥（随机长字符串，可用：python -c "import secrets;print(secrets.token_urlsafe(48))"）
PLUS_JWT_SECRET=请改为随机长字符串

# 服务端口
PLUS_API_PORT=8000

# TypeSafe JEV（AI 栏目分类与评分）；留空则不做 AI 分析
PLUS_JEV_API_KEY=
PLUS_BRIEFS_DEEPSEEK_API_KEY=
PLUS_BRIEFS_DEEPSEEK_MODEL=
