ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY jin10-server/app/web/workspace.js /srv/app/web/workspace.js
COPY jin10-server/app/web/workspace.css /srv/app/web/workspace.css
COPY jin10-server/app/web/briefs.js /srv/app/web/briefs.js
