ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY jin10-server/app/api/feedback.py /srv/app/api/feedback.py
COPY jin10-server/app/config.py /srv/app/config.py
COPY jin10-server/app/db/models.py /srv/app/db/models.py
COPY jin10-server/app/main.py /srv/app/main.py
COPY jin10-server/app/services/data_export.py /srv/app/services/data_export.py
COPY jin10-server/app/services/storage.py /srv/app/services/storage.py
COPY jin10-server/app/web/settings.html /srv/app/web/settings.html
COPY jin10-server/app/web/settings.js /srv/app/web/settings.js
COPY jin10-server/app/web/workspace.css /srv/app/web/workspace.css
COPY jin10-server/alembic/versions/0011_feedback.py /srv/alembic/versions/0011_feedback.py
COPY jin10-server/pyproject.toml /srv/pyproject.toml
RUN pip install --no-cache-dir "python-multipart>=0.0.9" \
    && chmod a+r /srv/app/api/feedback.py /srv/app/config.py /srv/app/db/models.py /srv/app/main.py \
       /srv/app/services/data_export.py /srv/app/services/storage.py /srv/app/web/settings.html \
       /srv/app/web/settings.js /srv/app/web/workspace.css /srv/alembic/versions/0011_feedback.py \
       /srv/pyproject.toml
USER plus
