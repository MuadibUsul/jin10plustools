ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY jin10-server/app/api/briefs.py /srv/app/api/briefs.py
COPY jin10-server/app/briefs/worker.py /srv/app/briefs/worker.py
COPY jin10-server/app/briefs/runner.py /srv/app/briefs/runner.py
COPY jin10-server/app/briefs/skill_production.py /srv/app/briefs/skill_production.py
COPY jin10-server/app/web/briefs.html /srv/app/web/briefs.html
COPY jin10-server/app/web/briefs.js /srv/app/web/briefs.js
COPY jin10-server/app/web/settings.html /srv/app/web/settings.html
COPY jin10-server/app/web/settings.js /srv/app/web/settings.js
RUN chmod -R a+rX /srv/app/api/briefs.py /srv/app/briefs/worker.py \
    /srv/app/briefs/runner.py /srv/app/briefs/skill_production.py \
    /srv/app/web/briefs.html /srv/app/web/briefs.js \
    /srv/app/web/settings.html /srv/app/web/settings.js
USER plus
